{
  "project_name": "book_tracker",
  "pages": [
    {
      "name": "UserSignupPage",
      "description": "Creates a new user account with a hashed password",
      "calls_api": {
        "method": "POST",
        "path": "/auth/signup",
        "base_url": "http://127.0.0.1:9100",
        "request_body": {
          "email": "string",
          "password": "string"
        },
        "response_body": {
          "id": "string",
          "email": "string"
        }
      }
    },
    {
      "name": "UserLoginPage",
      "description": "Logs in a user and returns a JWT access token",
      "calls_api": {
        "method": "POST",
        "path": "/auth/login",
        "base_url": "http://127.0.0.1:9100",
        "request_body": {
          "email": "string",
          "password": "string"
        },
        "response_body": {
          "access_token": "string",
          "token_type": "string"
        }
      }
    },
    {
      "name": "UserProfilePage",
      "description": "Returns the currently logged-in user's information",
      "calls_api": {
        "method": "GET",
        "path": "/users/me",
        "base_url": "http://127.0.0.1:9100",
        "response_body": {
          "id": "uuid",
          "email": "string"
        }
      }
    },
    {
      "name": "CreateBookPage",
      "description": "Adds a new book to the user's list",
      "calls_api": {
        "method": "POST",
        "path": "/books",
        "base_url": "http://127.0.0.1:9100",
        "request_body": {
          "owner_id": "string",
          "title": "string",
          "author": "string"
        },
        "response_body": {
          "id": "uuid",
          "owner_id": "string",
          "title": "string",
          "author": "string"
        }
      }
    },
    {
      "name": "BookListPage",
      "description": "Lists books with pagination",
      "calls_api": {
        "method": "GET",
        "path": "/books",
        "base_url": "http://127.0.0.1:9100",
        "query_params": {
          "limit": "int",
          "offset": "int"
        },
        "response_body": "array of {id, owner_id, title, author}"
      }
    }
  ]
}